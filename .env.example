DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional for dev: guild commands register instantly when set.
DISCORD_GUILD_ID=
# Optional: browser cookie string used when YouTube asks for sign-in confirmation.
YOUTUBE_COOKIE=
# info | warn | error
LOG_LEVEL=info
# Shared Chromium config root mounted from the host.
CHROMIUM_CONFIG_ROOT=/home/bot/.config/chromium
# Persistent Chromium profile directory used by both Playwright and yt-dlp.
CHROMIUM_PROFILE=/home/bot/.config/chromium/chromium
# Optional override; defaults to chromium:<CHROMIUM_PROFILE>.
YTDLP_COOKIES_FROM_BROWSER=
# Credentials used by scripts/refresh-yt-auth.js when a YouTube session expires.
GMAIL_USER=
GMAIL_PASS=
# Enable yt-dlp JavaScript challenge solving for newer YouTube flows.
YTDLP_ENABLE_JS_RUNTIME=1
YTDLP_JS_RUNTIME=node
